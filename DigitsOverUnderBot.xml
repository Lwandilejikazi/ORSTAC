<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
 <strategies>
  <strategy author="ChatGPT" title="Odd‑Even 120‑Tick VIX Strategy">
    <variables>
      <number name="stake" value="0.35"/>
      <number name="martingale_mul" value="2"/>
      <number name="max_profit" value="10"/>
      <number name="max_loss" value="50"/>
      <number name="profit" value="0"/>
      <number name="loss" value="0"/>
      <list name="last_digits_list"/>
    </variables>

    <!-- Helper function: classify last digit as odd or even -->
    <function name="get_odd_even">
      <parameter name="digit"/>
      <if>
        <condition expr="in(list(1,3,5,7,9), digit)"/>
        <true><![CDATA[
          return "odd"
        ]]></true>
        <false><![CDATA[
          return "even"
        ]]></false>
      </if>
    </function>

    <run>
      <!-- Initialization -->
      <do>
        <set name="profit" value="0"/>
        <set name="loss" value="0"/>
        <purge name="last_digits_list"/>
      </do>

      <loop>
        <!-- Break out if reached P/L limits -->
        <if>
          <condition expr="profit &gt;= max_profit or loss &gt;= max_loss"/>
          <then><break/></then>
        </if>

        <!-- Capture last digit of last tick and push into list -->
        <do>
          <store_last_digit list="last_digits_list" size="120"/>
        </do>

        <!-- Only evaluate when we have 120 digits -->
        <if>
          <condition expr="list_length(last_digits_list) == 120"/>
          <then>
            <!-- Compute count of odds -->
            <do>
              <set name="odd_count" value="0"/>
              <repeat list="last_digits_list" as="d">
                <do>
                  <set name="type" value="call_function('get_odd_even', d)"/>
                  <if>
                    <condition expr="type == 'odd'"/>
                    <then><inc name="odd_count"/></then>
                  </if>
                </do>
              </repeat>
              <set name="odd_pct" value="odd_count * 100 / 120"/>
              <set name="last1_type" value="call_function('get_odd_even', list_get(last_digits_list, 118))"/>
              <set name="last2_type" value="call_function('get_odd_even', list_get(last_digits_list, 119))"/>
            </do>

            <!-- Entry condition: >70% odds and last two both even -->
            <if>
              <condition expr="odd_pct &gt; 70 and last1_type == 'even' and last2_type == 'even'"/>
              <then>
                <!-- Place a FALL (Down) 1‑tick trade -->
                <do>
                  <set name="current_stake" value="stake"/>
                  <set name="trade_result" value="trade(type='callput', direction='put', stake=current_stake, duration=1, duration_unit='t')"/>
                  <if>
                    <condition expr="trade_result == 'win'"/>
                    <then>
                      <set name="profit" value="profit + current_stake * payout() - current_stake"/>
                      <set name="current_stake" value="stake"/>
                    </then>
                    <else>
                      <set name="loss" value="loss + current_stake"/>
                      <set name="current_stake" value="current_stake * martingale_mul"/>
                    </else>
                  </if>
                </do>
              </then>
            </if>
          </then>
        </if>
      </loop>

      <!-- Final state reporting -->
      <do>
        <log expr="'Finished: profit=' + profit + ', loss=' + loss"/>
      </do>
    </run>
  </strategy>
</strategies>
 
